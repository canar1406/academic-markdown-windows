{
  "name": "markdown-latex-macos",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "test": "pnpm -r test",
    "test:pdf-golden-utils": "node --test scripts/test/pdf-golden-lib.test.mjs",
    "test:pdf-golden": "pnpm --filter @markdown/latex-exporter test:pdf-golden",
    "licenses:notice": "node scripts/generate-third-party-notices.mjs",
    "typecheck": "pnpm -r typecheck",
    "build:web": "pnpm --filter @markdown/editor build"
  }
}
