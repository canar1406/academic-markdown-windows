{
  "schemaVersion": 1,
  "id": "hcmut-report-v1",
  "name": "HCMUT Engineering Report",
  "version": "1.0.0-beta.1",
  "engine": "latex",
  "documentClass": "article",
  "page": {
    "size": "A4"
  },
  "capabilities": {
    "cover": true,
    "toc": true,
    "listOfFigures": true,
    "listOfTables": true,
    "header": true,
    "footer": true,
    "headingDepth": 4
  },
  "components": {
    "document": "document.tex.mustache",
    "preamble": "preamble.tex",
    "cover": "components/cover.tex.mustache",
    "header": "components/header.tex.mustache",
    "footer": "components/footer.tex.mustache",
    "frontmatter": "components/frontmatter.tex.mustache",
    "front-section": "components/front-section.tex.mustache",
    "heading-1": "components/heading-1.tex.mustache",
    "heading-2": "components/heading-2.tex.mustache",
    "heading-3": "components/heading-3.tex.mustache",
    "heading-4": "components/heading-4.tex.mustache",
    "figure": "components/figure.tex.mustache",
    "table": "components/table.tex.mustache",
    "listing": "components/code-listing.tex.mustache",
    "theorem": "components/theorem.tex.mustache",
    "property": "components/property.tex.mustache",
    "proposition": "components/proposition.tex.mustache",
    "corollary": "components/corollary.tex.mustache",
    "lemma": "components/lemma.tex.mustache",
    "exercise": "components/exercise.tex.mustache",
    "page-break": "components/page-break.tex.mustache"
  },
  "assets": [
    "assets/hcmut.png"
  ],
  "settings": [
    { "key": "cover.university", "type": "string", "label": "Đại học", "required": false, "section": "Cover" },
    { "key": "cover.school", "type": "string", "label": "Trường", "required": false, "section": "Cover" },
    { "key": "cover.faculty", "type": "string", "label": "Khoa", "required": true, "section": "Cover" },
    { "key": "cover.reportType", "type": "string", "label": "Loại báo cáo", "required": true, "section": "Cover" },
    { "key": "cover.title", "type": "string", "label": "Tên đề tài", "required": true, "section": "Cover" },
    { "key": "cover.major", "type": "string", "label": "Ngành", "required": false, "section": "Cover" },
    { "key": "cover.council", "type": "string", "label": "Hội đồng", "required": false, "section": "Cover" },
    { "key": "cover.supervisor", "type": "string", "label": "GVHD", "required": false, "section": "Cover" },
    { "key": "cover.secretary", "type": "string", "label": "Thư ký hội đồng", "required": false, "section": "Cover" },
    { "key": "cover.locationDate", "type": "string", "label": "Địa điểm và thời gian", "required": false, "section": "Cover" },
    { "key": "cover.heading", "type": "string", "label": "Dòng tiêu đề bìa", "required": false, "section": "Cover" },
    { "key": "cover.logoEnabled", "type": "boolean", "label": "Hiện logo bìa", "required": false, "section": "Cover" },
    { "key": "cover.logoWidthCm", "type": "number", "label": "Độ rộng logo bìa (cm)", "required": false, "section": "Cover" },
    { "key": "cover.borderEnabled", "type": "boolean", "label": "Hiện khung bìa", "required": false, "section": "Cover" },
    { "key": "cover.outerBorderWidthPt", "type": "number", "label": "Độ dày khung ngoài (pt)", "required": false, "section": "Cover" },
    { "key": "cover.innerBorderWidthPt", "type": "number", "label": "Độ dày khung trong (pt)", "required": false, "section": "Cover" },
    { "key": "structure.tocDepth", "type": "number", "label": "Độ sâu mục lục", "required": false, "section": "Structure" },
    { "key": "header.enabled", "type": "boolean", "label": "Hiện đầu trang", "required": false, "section": "Header" },
    { "key": "header.institution", "type": "string", "label": "Đơn vị", "required": false, "section": "Header" },
    { "key": "header.faculty", "type": "string", "label": "Khoa", "required": false, "section": "Header" },
    { "key": "header.logoEnabled", "type": "boolean", "label": "Hiện logo đầu trang", "required": false, "section": "Header" },
    { "key": "header.logoSizeMm", "type": "number", "label": "Kích thước logo đầu trang (mm)", "required": false, "section": "Header" },
    { "key": "header.fontSizePt", "type": "number", "label": "Cỡ chữ đầu trang (pt)", "required": false, "section": "Header" },
    { "key": "header.bold", "type": "boolean", "label": "Chữ đậm đầu trang", "required": false, "section": "Header" },
    { "key": "header.ruleEnabled", "type": "boolean", "label": "Hiện đường kẻ đầu trang", "required": false, "section": "Header" },
    { "key": "header.ruleWidthPt", "type": "number", "label": "Độ dày đường kẻ đầu trang (pt)", "required": false, "section": "Header" },
    { "key": "footer.enabled", "type": "boolean", "label": "Hiện chân trang", "required": false, "section": "Footer" },
    { "key": "footer.left", "type": "string", "label": "Nội dung chân trang", "required": true, "section": "Footer" },
    { "key": "footer.pageNumber", "type": "select", "label": "Số trang", "required": false, "section": "Footer", "options": ["current-total", "current", "none"] },
    { "key": "footer.fontSizePt", "type": "number", "label": "Cỡ chữ chân trang (pt)", "required": false, "section": "Footer" },
    { "key": "footer.ruleEnabled", "type": "boolean", "label": "Hiện đường kẻ chân trang", "required": false, "section": "Footer" },
    { "key": "footer.ruleWidthPt", "type": "number", "label": "Độ dày đường kẻ chân trang (pt)", "required": false, "section": "Footer" }
  ]
}
