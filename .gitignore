.DS_Store
node_modules/

# Generated web/native builds
apps/editor/dist/
apps/macos/.build/
build/
output/
tmp/

# Local automation/session state
.playwright-cli/
.claude/settings.local.json
.codex/

# Generated editor resources are rebuilt by scripts/sync-editor-bundle.sh
apps/macos/Sources/MarkdownMacOS/Resources/Web/*
