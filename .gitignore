# TeX and tooling build artifacts outside the supplied archive fixtures
*.aux
*.log
*.out
*.ptc
*.toc
*.thm
*.synctex.gz

# Never publish machine credentials or test artifacts
.env
.env.*
*.p12
*.pfx
*.pem
*.key
**/test-results/
